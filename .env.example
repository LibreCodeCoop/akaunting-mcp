# Copy to .env.deploy; do not commit actual values.
AKAUNTING_BASE_URL=https://accounting.example.org
MCP_OAUTH_ISSUER=https://accounting.example.org/akaunting-mcp-auth
MCP_OAUTH_ORIGIN=https://accounting.example.org
MCP_OAUTH_CLIENT_ID=registered-oauth-client-id
# Stable ChatGPT callback requires issuer identification in OAuth metadata + response.
MCP_OAUTH_REDIRECT_URI=https://chatgpt.com/connector_platform_oauth_redirect
OPENAI_TUNNEL_ID=tunnel_REPLACE_WITH_REGISTERED_ID
MCP_RESOURCE_URI=https://api.openai.com/v1/mcp/tunnel_REPLACE_WITH_REGISTERED_ID
MCP_ALLOWED_HOSTS=nginx,127.0.0.1,localhost
MCP_PROXY_NETWORK=reverse-proxy
MCP_OAUTH_EDGE_ALIAS=akaunting-mcp-oauth-edge
APP_UID=10001
APP_GID=10001
